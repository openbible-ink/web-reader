{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "audit:scripture": "node scripts/audit-scripture-integrity.mjs",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "check": "npm run types:check && npm run lint && npm run format:check",
        "check:fix": "npm run lint:fix && npm run format && npm run types:check",
        "types:check": "tsc --noEmit",
        "lint": "eslint --max-warnings=0 resources/js tests/e2e scripts *.ts *.js",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write resources/js resources/css scripts tests/e2e *.ts *.js *.json \"docs/**/*.md\" .github/workflows",
        "format:check": "prettier --check resources/js resources/css scripts tests/e2e *.ts *.js *.json \"docs/**/*.md\" .github/workflows",
        "audit:dependencies": "npm audit --omit=dev --audit-level=high",
        "test:e2e": "npm run scripture:compile && npm run build && playwright test",
        "test:e2e:ui": "npm run build && playwright test --ui",
        "performance:check": "node scripts/check-performance-budget.mjs",
        "scripture:compile": "node scripts/compile-scripture-chapters.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tiptap/extension-placeholder": "^3.32.0",
        "@tiptap/markdown": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "input-otp": "^1.4.2",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tw-animate-css": "^1.4.0",
        "usfm-parser": "file:../usfm-parser"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@babel/core": "^7.28.0",
        "@eslint/js": "^9.39.5",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
